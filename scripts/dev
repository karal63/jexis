#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"
load_environment dev
require_config
command -v java >/dev/null || fail 'Install Java 17 or newer (Gradle uses a Java 17 toolchain).'
require_docker
compose up -d --wait --wait-timeout 120
printf '%s\n' "Starting DEV at http://localhost:$APP_PORT/api (Ctrl+C stops Java only)."
exec ./gradlew bootRun --args='--spring.profiles.active=dev'
